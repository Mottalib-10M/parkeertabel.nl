---
/** Une page de ville ou de thème : H1, réponse en une ligne, la rekenhulp tout de suite, la réponse repliée, le corps, FAQ, sources. */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import AdresZoeker from './calc/AdresZoeker';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { label, GROUPS } from '../i18n/nav';
import { t } from '../i18n/ui';
import { helpers, sourceList } from '../lib/helpers';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/page-types';
import { pageById } from '../lib/pages';
import { CITY_PAGES } from '../lib/planned';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang]!;
const ui = t(lang);
const path = route(page.id, lang);
const group = GROUPS.find((g) => g.id === page.group)!;
const jsonLd = [webApplicationSchema({ name: x.h1, description: x.description, path, lang }), articleSchema({ title: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }])];
if (x.faqs.length) jsonLd.push(faqSchema(x.faqs, lang));
const related = page.related.filter((id) => hasRoute(id, lang)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.[lang]?.card ?? (id === 'home' ? HOME[lang].homeCard : '') }));
const sources = sourceList(page.sources, lang);
const cityLinks = Object.fromEntries(CITY_PAGES.filter((id) => hasRoute(id, lang)).map((id) => [id, route(id, lang)]));
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} related={related} sources={sources} breadcrumbs={[{ label: group.label[lang] }, { label: x.nav }]}>
  <article>
    <header class="mb-4">
      <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
      <div class="mt-1 text-xs font-medium uppercase tracking-wide text-navy-500">{ui.independent}</div>
    </header>
    {page.tool === 'kosten' && <div data-chrome class="mb-3"><AdresZoeker client:load lang={lang} target={path} cityLinks={cityLinks} /></div>}
    <div id="rekenhulp" data-outil data-chrome class="mb-4 scroll-mt-20"><Tool kind={page.tool} lang={lang} arg={page.toolArg} idPrefix={`p${page.order}`} /></div>
    <p class="mb-6 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
    <Clamp text={x.resume} lang={lang} id={`clamp-${page.id}`} class="mb-8" />
    <Body html={x.body(helpers(lang))} path={path} lang={lang} plegar />
  </article>
</PageLayout>
