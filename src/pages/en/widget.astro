---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/${lang}/parkeerkosten/" title="Dutch parking cost by city and zone 2026" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Dutch parking cost calculator 2026 for free" description="Embed the 2026 Dutch parking cost calculator for free with an iframe: rate, zone and paid hours by city from the National Parking Register. No account, nothing to install." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For businesses, venues, hotels and residents' associations: copy it once and your visitors see what parking nearby costs.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p set:html={`For the Dutch version, change <code>/embed/en/</code> to <code>/embed/nl/</code>. Terms: the link under the calculator stays visible and unchanged, with no warranty. What your visitors type stays on their device. The register is re-read automatically every Monday.`} />
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/parkeerkosten/`} title="Dutch parking cost by city and zone 2026" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
