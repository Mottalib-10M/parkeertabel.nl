---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'Who publishes Parkeertabel in 2026: independent, open data';
const description = 'Parkeertabel is published by Radif Partners: free 2026 calculators of Dutch parking costs, built on the RDW National Parking Register. Not a municipality.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About Parkeertabel and its publisher</h1>
    <div class="not-prose text-xs font-medium uppercase tracking-wide text-navy-500">Independent site: not a municipality and not a parking app</div>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why Parkeertabel exists</h2>
    <p>Each Dutch municipality publishes its parking rates in its own way: a map here, a PDF there, a by-law with dozens of zones. Parking apps show the price only once you have started a session. Yet the rates, zones and hours of almost every paid zone are in one public register. Parkeertabel turns that register into a calculator: a city, a zone, a time, and you see the cost before you park.</p>
    <h2>The publisher</h2>
    <p>{AUTHOR_NAME}, a French company that builds calculators from public data for several countries; hence the address in France below. It is not a municipality, a parking operator or a payment app, uses no logos of any administration, charges nothing and has no affiliate links.</p>
    <LegalIdentity lang={lang} />
    <h2>Sources</h2>
    <p>Rates and hours: <Fragment set:html={s('npr_tarief', 'RDW Open Data Parkeren')} /> (National Parking Register, CC0). Permits and penalty costs: the municipal parking tax by-laws, such as <Fragment set:html={s('vo_utrecht', "Utrecht's 2026 by-law")} />. Addresses: <Fragment set:html={s('pdok', 'PDOK Locatieserver')} />. The <a href={route('method', lang)}>method</a> explains how they are used and the <a href={route('editorial', lang)}>editorial policy</a> how they are corrected.</p>
    <h2>What we do not do</h2>
    <p>We sell no parking time, issue no permits, handle no objections to fines and give no legal advice. The amount shown is an estimate under the published rates; the meter or app on the spot decides. Nothing you type leaves your browser except an address sent to PDOK: see the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, if a rate, a time or a zone looks wrong.</p>
  </article>
</PageLayout>
