---
/** Pages à insérer (iframe) : la rekenhulp seule, en néerlandais et en anglais. noindex, hors sitemap (astro.config). */
import '../../../styles/global.css';
import Tool from '../../../components/Tool.astro';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../../data/site-config';
import { route } from '../../../i18n/routes';
import { displayDate, type Lang } from '../../../lib/format';
import { READ } from '../../../lib/engine/parking';
const EMBEDS = { parkeerkosten: { kind: 'kosten', t: { nl: 'Parkeerkosten per stad en zone 2026', en: 'Dutch parking cost by city and zone 2026' } } } as const;
export function getStaticPaths() {
  return (['nl', 'en'] as const).map((lang) => ({ params: { lang, name: 'parkeerkosten' } }));
}
const { lang, name } = Astro.params as { lang: Lang; name: keyof typeof EMBEDS };
const e = EMBEDS[name];
const page = `${SITE_URL}${route('home', lang)}`;
const rdw = '<a href="https://opendata.rdw.nl/Parkeren/Open-Data-Parkeren-TARIEFDEEL/534e-5vdg" rel="nofollow noopener" target="_blank" class="underline">RDW Open Data Parkeren</a>';
const note = { nl: `Onafhankelijke site, geen gemeente en geen parkeerapp · tarieven uit het Nationaal Parkeer Register (${rdw}, CC0), gelezen op ${displayDate(READ, 'nl')} · rekenhulp van Radif Partners`, en: `Independent site, not a municipality or a parking app · rates from the National Parking Register (${rdw}, CC0), read on ${displayDate(READ, 'en')} · calculator by Radif Partners` }[lang];
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${e.t[lang]} (${lang === 'nl' ? 'insluiten' : 'embed'})`}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind={e.kind} lang={lang} idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={page} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · <Fragment set:html={note} /></p>
  </body>
</html>
